<log4net>
  <appender name="Console" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss} [%level] %message%newline" />
    </layout>
  </appender>

  <appender name="ProcessFile" type="log4net.Appender.FileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDir}\process_%date{yyyyMMdd_HHmmss}.log" />
    <appendToFile value="false" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss} [%level] %message%newline" />
    </layout>
  </appender>

  <root>
    <level value="INFO" />
    <appender-ref ref="Console" />
    <appender-ref ref="ProcessFile" />
  </root>
</log4net>
